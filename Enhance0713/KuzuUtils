{"blocks":[{"type":"codeTool","data":{"codeData":{"value":"async function downloadFileByType(fileType, array, csvTitle) {\n  if (array) {\n    if (fileType === 'csv') {\n      let content = ConvertToCSV(array, false, true);\n      const file = new File([content], { type: 'text/plain', endings: 'transparent' });\n      const url = URL.createObjectURL(file);\n      saveLink(url, csvTitle + \".csv\");\n    } else if (fileType === 'xlsx') {\n      let buffer = await ConvertToXLSX(csvTitle, array);\n      const blob = new Blob([buffer], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;charset=utf-8' });\n      saveLink(URL.createObjectURL(blob), csvTitle + \".xlsx\");\n    }\n  }\n}","pinCode":false,"dname":"3e02cd6d-9366-41f2-88f8-f300423af789","codeMode":"javascript2"}}},{"type":"codeTool","data":{"codeData":{"value":"/**\n * \n * @param {{}[]} objects \n */\nfunction extractAllKeys(objects) {\n  let obj = {};\n  _.each(objects, (object) => {\n    _.each(object, (value, key) => {\n      if (undefined === obj[key]) {\n        obj[key] = value;\n      }\n    })\n  })\n  return _.keys(obj);\n}","pinCode":false,"dname":"c693c39f-5b65-4556-ab30-5427ea171ced","codeMode":"javascript2"}}},{"type":"codeTool","data":{"codeData":{"value":"async function ConvertToXLSX(sheetName, objArray) {\n  let workbook = new ExcelJS.Workbook();\n  let array = typeof objArray != 'object' ? JSON.parse(objArray) : objArray;\n  let keys = objArray.columns || extractAllKeys(objArray)\n  let columns = _.reduce(keys, (prev, key, index) => {\n    prev.push({ header: key, key: key, width: key.length });\n    return prev;\n  }, [])\n  const worksheet = workbook.addWorksheet(`${sheetName}`);\n  worksheet.columns = columns;\n  for (let i = 0; i < array.length; i++) {\n    if (typeof array[i] != 'object') {\n      continue;\n    }\n    worksheet.addRow(array[i]);\n  }\n  return await workbook.xlsx.writeBuffer()\n}","pinCode":false,"dname":"650fa311-d265-421d-a02b-82823f0c60ce","co