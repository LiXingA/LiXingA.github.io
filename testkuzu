{"blocks":[{"type":"codeTool","data":{"codeData":{"value":"## kuzu api","pinCode":false,"dname":"916e846b-105e-4d4e-ac73-37224abe68c1","codeMode":"markdown"}}},{"type":"codeTool","data":{"codeData":{"value":"viewof button_6 = Inputs.button(\"Fetch\",{reduce:async ()=>{\n  return await (await commonFetch(`/api/kuzu/query/${projectId}/default?query=match(n)-[r]-(m) return *`)).json()\n        }})","pinCode":true,"dname":"aebd88b8-9ed3-43d8-a255-9306700b2313","codeMode":"javascript2"}}},{"type":"codeTool","data":{"codeData":{"value":"button_6","pinCode":true,"dname":"7f6a7f57-4ea2-441a-abc8-1b7fbade0abb","codeMode":"javascript2"}}},{"type":"codeTool","data":{"codeData":{"value":"viewof button_7 = Inputs.button(\"POST\",{\n  reduce:async () => { \n    return await fetch(`/api/kuzu/query/${projectId}/default`, {\n      method: 'POST',\n      headers: {\n        'Content-Type': 'application/json'\n      },\n      body: JSON.stringify({\n        query: 'match(n)-[r]-(m) return * limit $limit',\n        parameters:{\n          limit: 2\n        }\n      })\n    })\n      .then(response => response.json())\n      .then(data => data?.content)\n      .catch(error => error);\n\n  }\n})","pinCode":true,"dname":"c07deda9-67ca-449d-bba5-a3f14a59d4fe","codeMode":"javascript2"}}},{"type":"codeTool","data":{"codeData":{"value":"button_7","pinCode":true,"dname":"99807436-5628-40c5-93a0-fec7c7094e6a","codeMode":"javascript2"}}},{"type":"codeTool","data":{"codeData":{"value":"commonFetch = function (resource, ...args) {\n  return fetch(prefixAliasPath(resource), ...args);\n}","pinCode":true,"dname":"cfd09cb6-287d-49d8-bb43-23aae537e926","codeMode":"javascript2"}}},{"type":"codeTool","data":{"codeData":{"value":"window.groveConfig","pinCode":true,"dname":"9a02e028-0363-417f-9b67-6a6e5dea5590","codeMode":"javascript2"}}},{"type":"codeTool","data":{"codeData":{"value":"GROVE_HELP_URL = \"https://grove-help.graphxr.com/\";","pinCode":true,"dname":"d9354528-cc38-4f2b-92ed-76f6ad60936a","codeMode":"javascript2"}}},{"type":"codeTool","data":{"codeData":{"value":"prefixAliasPath = function (path) {\n    if (!path) {\n      return path;\n    }\n    if (path.startsWith(\"blob:\")) {\n      return path;\n    }\n    if ((window.groveConfig?.noOnlineRequire) && path.startsWith(GROVE_HELP_URL)) {\n      path = path.replace(GROVE_HELP_URL, window.GUIDE_LINK_URI);\n    }\n    if (!ALIAS_PATH) return path\n    if (!path.startsWith('/')) return path;\n    if (path.startsWith(ALIAS_PATH)) return path\n    return ALIAS_PATH + path;\n  }","pinCode":true,"dname":"bf11868e-d9bd-465e-9f01-244e4f1f036a","codeMode":"javascript2"}}},{"type":"codeTool","data":{"codeData":{"value":"ALIAS_PATH = OPENER.globalVariable.aliasPath ?? '';","pinCode":true,"dname":"1efa1930-2f81-48e5-b442-51833460155c","codeMode":"javascript2"}}},{"type":"codeTool","data":{"codeData":{"value":"OPENER = window?.parent?.globalVariable ? window.parent : window.opener;","pinCode":true,"dname":"af9dc4b6-fbe0-44ca-9704-16c1f11a5f33","codeMode":"javascript2"}}},{"type":"codeTool","data":{"codeData":{"value":"projectId = OPENER.globalVariable.project._id","pinCode":true,"dname":"da275ba6-b862-4ce5-80fc-261ffd67e2c8","codeMode":"javascript2"}}},{"type":"codeTool","data":{"codeData":{"value":"kuzuId = 'default'","pinCode":true,"dname":"9a500864-b6af-4af9-852f-45fe7bb96056","codeMode":"javascript2"}}},{"type":"codeTool","data":{"codeData":{"value":"viewof button_5 = Inputs.button(\"drop database kuzuDBName\",{reduce:async ()=>{\n           return await gxr.query(`drop database kuzuDBName`)\n        }})","pinCode":false,"dname":"01147c31-a096-4ff0-acba-d64b0bf7a91d","codeMode":"javascript2"}}},{"type":"codeTool","data":{"codeData":{"value":"viewof button_4 = Inputs.button(\"create database kuzuDBName\",{reduce:async ()=>{\n           return await gxr.query(`create database kuzuDBName`)\n        }})","pinCode":false,"dname":"b365c2bf-57eb-45af-8444-adf8b025017d","codeMode":"javascript2"}}},{"type":"codeTool","dat