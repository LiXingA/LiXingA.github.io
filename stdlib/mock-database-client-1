{"blocks":[{"type":"codeTool","data":{"codeData":{"value":"md`# Mock Database Client\n\nSmoke-and-mirrors version of [database clients](/@observablehq/connecting-to-databases) to demonstrate their API. Please pardon the deception. Real clients are 👌🏼.`","pinCode":false,"dname":"5f69b5ea-47ba-4ae5-9059-32536b8a91ab","codeMode":"javascript2"}}},{"type":"codeTool","data":{"codeData":{"value":"MockDatabaseClient = (function MockDatabaseClient(name) {\n  switch (name) {\n    case \"Baby Names\": return FileAttachment(\"names.db\").sqlite();\n    case \"Weather\": return FileAttachment(\"weather.sqlite\").sqlite();\n    default: throw new Error(`database not found: ${name}`);\n  }\n})","pinCode":false,"dname":"a8bcf1ff-2b10-4cc2-8860-9ab89771272b","codeMode":"javascript2"}}},{"type":"codeTool","data":{"codeData":{"value":"MockDatabaseClient(\"does_not_exist\")","pinCode":false,"dname":"4f1da9a8-b109-4e1a-9f60-15d07a11ba6b","codeMode":"javascript2"}}},{"type":"codeTool","data":{"codeData":{"value":"dc = (MockDatabaseClient(\"Baby Names\"))","pinCode":false,"dname":"8513e62a-a3fa-4cb7-b711-549c0654dbe1","codeMode":"javascript2"}}},{"type":"codeTool","data":{"codeData":{"value":"dc.query(`\n  SELECT *\n  FROM names\n  WHERE name IN (?, ?)\n`, [\"Loki\", \"Thor\"])","pinCode":false,"dname":"5d8bef7a-6f87-4fad-b205-fe2cd9c6d92d","codeMode":"javascript2"}}},{"type":"codeTool","data":{"codeData":{"value":"dc.explain(`\n  SELECT *\n  FROM names\n  WHERE name = 'Loki'\n`)","pinCode":false,"dname":"b89455eb-5698-4adc-b945-4751dc040336","codeMode":"javascript2"}}},{"type":"codeTool","data":{"codeData":{"value":"viewof desc = (dc.describe(\"names\"))","pinCode":false,"dname":"4e480003-e35a-419a-8520-b95b273c7564","codeMode":"javascript2"}}},{"type":"codeTool","data":{"codeData":{"value":"desc","pinCode":false,"dname":"e95b6151-9db6-45ef-b864-e6b34aa7b127","codeMode":"javascript2"}}}],"version":"2.19.1"}